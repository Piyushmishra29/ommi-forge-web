# --------------------------------------------------------------------
# Ommi Forge — environment variables (copy to .env.local to opt in)
# --------------------------------------------------------------------
# Every var here is OPTIONAL. The site builds and runs with zero env.
# All vars are NEXT_PUBLIC_* because we ship as a static export — they
# are inlined into the client bundle at build time.
# --------------------------------------------------------------------

# Formspree endpoint for the /contact form.
# Create a project at https://formspree.io, paste its endpoint URL here.
# Leaving this unset keeps the form in "log only" mode (no network call,
# console.info on submit, success state still flips).
NEXT_PUBLIC_FORMSPREE_URL=

# Plausible analytics (https://plausible.io). Leave unset for no
# analytics. Set the domain you registered in Plausible (e.g.
# "www.ommiforge.com") to enable the cloud-hosted script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Self-hosted Plausible: full script URL (e.g.
# "https://stats.example.com/js/script.js"). When set, the layout uses
# this src instead of the public plausible.io script.
NEXT_PUBLIC_PLAUSIBLE_SRC=
