# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw WordPress upload mirror — kept as a fallback safety net but not versioned
/public/assets/wp-mirror/

# Master JPG originals from client — too large to commit. Optimized
# scaled/AVIF/WebP siblings are generated into the parent folder.
/public/assets/images/originals/

# Local master assets — kept on disk, never shipped or committed
/_masters/
